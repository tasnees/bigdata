      "cell_type": "code",
      "metadata": {},
      "source": [
        "# --------------------------------------------------------------\n",
        "# 1️⃣  Environment – must be executed before any Spark import\n",
        "# --------------------------------------------------------------\n",
        "import os, pathlib, sys\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# Paths that you already verified\n",
        "# ------------------------------------------------------------------\n",
        "HADOOP_HOME    = r\"C:\\Users\\21625\\Desktop\\bigdata\\hadoop\"\n",
        "SPARK_TMP      = r\"C:\\Users\\21625\\Desktop\\bigdata\\spark_temp\"\n",
        "JAVA_HOME      = r\"C:\\Program Files\\Microsoft\\jdk-17.0.21.21-hotspot\"   # no trailing slash\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# Export them for the Python process\n",
        "# ------------------------------------------------------------------\n",
        "os.environ[\"HADOOP_HOME\"]      = HADOOP_HOME\n",
        "os.environ[\"JAVA_HOME\"]        = JAVA_HOME\n",
        "os.environ[\"SPARK_LOCAL_DIRS\"] = SPARK_TMP\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# Forward‑slash version for the JVM argument (avoids escaping backslashes)\n",
        "# ------------------------------------------------------------------\n",
        "hadoop_fwd = HADOOP_HOME.replace(\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", \"/\")\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# Critical: inject the JVM system property *before* any Spark code runs\n",
        "# ------------------------------------------------------------------\n",
        "os.environ[\"PYSPARK_SUBMIT_ARGS\"] = (\n",
        "    f'--driver-java-options \"-Dhadoop.home.dir={hadoop_fwd}\" pyspark-shell'\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# Sanity‑check (you should see the exact string printed)\n",
        "# ------------------------------------------------------------------\n",
        "print(\"PYSPARK_SUBMIT_ARGS →\", os.getenv(\"PYSPARK_SUBMIT_ARGS\"))\n",
        "print(\"HADOOP_HOME          →\", os.getenv(\"HADOOP_HOME\"))\n",
        "print(\"JAVA_HOME            →\", os.getenv(\"JAVA_HOME\"))\n",
        "print(\"winutils.exe present:\", pathlib.Path(HADOOP_HOME, \"bin\", \"winutils.exe\").is_file())\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# --------------------------------------------------------------\n",
        "# 2️⃣  Spark setup – now safe to import\n",
        "# --------------------------------------------------------------\n",
        "from pyspark.sql import SparkSession\n",
        "from delta import configure_spark_with_delta_pip\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "builder = (\n",
        "    SparkSession.builder\n",
        "    .appName(\"dl_risk\")\n",
        "    .master(\"local[*]\")\n",
        "    .config(\"spark.sql.extensions\", \"io.delta.sql.DeltaSparkSessionExtension\")\n",
        "    .config(\"spark.sql.catalog.spark_catalog\", \"org.apache.spark.sql.delta.catalog.DeltaCatalog\")\n",
        ")\n",
        "\n",
        "spark = configure_spark_with_delta_pip(builder).getOrCreate()\n",
        "spark.sparkContext.setLogLevel(\"WARN\")\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# Read the *Silver* table you already generate (cleaned + standardized)\n",
        "# ------------------------------------------------------------------\n",
        "silver_path = \"data/lakehouse/silver/market_bars\"\n",
        "silver_df   = spark.read.format(\"delta\").load(silver_path)\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# Convert to Pandas – OK for prototyping (if > ~2 M rows switch to pyspark.pandas)\n",
        "# ------------------------------------------------------------------\n",
        "pdf = silver_df.toPandas()\n",
        "print(\"Rows loaded:\", len(pdf))\n",
        "pdf.head()\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# --------------------------------------------------------------\n",
        "# 3️⃣  Build numeric features that the model will learn from\n",
        "# --------------------------------------------------------------\n",
        "pdf = pdf.sort_values(['symbol', 'date'])\n",
        "\n",
        "# Log‑return of the adjusted close price\n",
        "pdf['log_ret'] = np.log(pdf['Adj Close'] / pdf['Adj Close'].shift(1))\n",
        "\n",
        "# 10‑day rolling volatility (standard deviation of log‑returns)\n",
        "pdf['vol_10'] = (\n",
        "    pdf.groupby('symbol')['log_ret']\n",
        "       .transform(lambda s: s.rolling(10, min_periods=1).std())\n",
        ")\n",
        "\n",
        "# Target: next‑day volatility (what we want the model to predict)\n",
        "pdf['target'] = pdf.groupby('symbol')['vol_10'].shift(-1).fillna(0)\n",
        "\n",
        "# Keep only the columns we actually need for training\n",
        "feature_cols = ['log_ret', 'vol_10']\n",
        "X = pdf[feature_cols].values.astype(np.float32)\n",
        "y = pdf['target'].values.astype(np.float32)\n",
        "\n",
        "# Train‑/validation split *by date* – no look‑ahead leakage\n",
        "split_date = pd.Timestamp('2025-01-01')\n",
        "train_mask = pdf['date'] < split_date\n",
        "X_train, X_val = X[train_mask], X[~train_mask]\n",
        "y_train, y_val = y[train_mask], y[~train_mask]\n",
        "\n",
        "print(f\"Train rows: {X_train.shape[0]}, Val rows: {X_val.shape[0]}\")\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# --------------------------------------------------------------\n",
        "# 4️⃣  PyTorch model – a 2‑layer LSTM that predicts next‑day vol\n",
        "# --------------------------------------------------------------\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "from torch.utils.data import TensorDataset, DataLoader\n",
        "\n",
        "class VolatilityLSTM(nn.Module):\n",
        "    def __init__(self, input_dim=2, hidden=32, layers=2):\n",
        "        super().__init__()\n",
        "        self.lstm = nn.LSTM(input_dim, hidden, num_layers=layers, batch_first=True)\n",
        "        self.fc   = nn.Linear(hidden, 1)\n",
        "\n",
        "    def forward(self, x):\n",
        "        # x shape: (batch, seq_len=1, input_dim)\n",
        "        out, _ = self.lstm(x)          # LSTM returns (output, (h_n, c_n))\n",
        "        out = out[:, -1, :]           # take the last hidden state\n",
        "        return self.fc(out).squeeze(-1)\n",
        "\n",
        "# reshape to (batch, seq_len=1, input_dim)\n",
        "X_train_seq = torch.from_numpy(X_train).unsqueeze(1)   # (N,1,2)\n",
        "y_train_seq = torch.from_numpy(y_train)\n",
        "\n",
        "train_ds = TensorDataset(X_train_seq, y_train_seq)\n",
        "train_dl = DataLoader(train_ds, batch_size=512, shuffle=True)\n",
        "\n",
        "model = VolatilityLSTM()\n",
        "criterion = nn.MSELoss()\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
        "\n",
        "epochs = 12\n",
        "for epoch in range(1, epochs + 1):\n",
        "    model.train()\n",
        "    epoch_loss = 0.0\n",
        "    for xb, yb in train_dl:\n",
        "        optimizer.zero_grad()\n",
        "        preds = model(xb)\n",
        "        loss = criterion(preds, yb)\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        epoch_loss += loss.item() * xb.size(0)\n",
        "    print(f\"epoch {epoch:02d} – train loss {epoch_loss/len(train_ds):.6f}\")\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# --------------------------------------------------------------\n",
        "# 5️⃣  Validation – compute RMSE on the hold‑out set\n",
        "# --------------------------------------------------------------\n",
        "model.eval()\n",
        "with torch.no_grad():\n",
        "    X_val_seq = torch.from_numpy(X_val).unsqueeze(1)   # (N,1,2)\n",
        "    val_pred  = model(X_val_seq).numpy()\n",
        "    val_rmse  = np.sqrt(((val_pred - y_val) ** 2).mean())\n",
        "print(f\"✅ Validation RMSE: {val_rmse:.6f}\")\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# --------------------------------------------------------------\n",
        "# 6️⃣  Persist the trained model checkpoint\n",
        "# --------------------------------------------------------------\n",
        "model_path = \"model_vol_lstm.pt\"\n",
        "torch.save(model.state_dict(), model_path)\n",
        "print(f\"✅ Model checkpoint saved to {model_path}\")\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# --------------------------------------------------------------\n",
        "# 7️⃣  Spark‑side inference – pandas UDF that loads the model once per executor\n",
        "# --------------------------------------------------------------\n",
        "import torch\n",
        "import pandas as pd\n",
        "from pyspark.sql.functions import pandas_udf, PandasUDFType\n",
        "\n",
        "# Load the checkpoint (the file is on the driver; Spark will ship it to executors)\n",
        "weights = torch.load(model_path, map_location='cpu')\n",
        "inference_model = VolatilityLSTM()\n",
        "inference_model.load_state_dict(weights)\n",
        "inference_model.eval()\n",
        "\n",
        "@pandas_udf('double', PandasUDFType.SCALAR)\n",
        "def predict_vol(log_ret: pd.Series, vol_10: pd.Series) -> pd.Series:\n",
        "    # Stack the two feature columns into a (batch, 2) NumPy array\n",
        "    inp = np.stack([log_ret.values, vol_10.values], axis=1).astype(np.float32)\n",
        "    # Add the sequence dimension expected by the LSTM: (batch, 1, 2)\n",
        "    inp_tensor = torch.from_numpy(inp).unsqueeze(1)   # (N,1,2)\n",
        "    with torch.no_grad():\n",
        "        out = inference_model(inp_tensor).numpy()\n",
        "    return pd.Series(out.squeeze())\n",
        "\n",
        "# ------------------------------------------------------------------\n",
        "# Example: score the Bronze raw bars (or Silver) and write to Gold\n",
        "# ------------------------------------------------------------------\n",
        "bronze_path = \"data/lakehouse/bronze/market_bars\"\n",
        "bronze_df   = spark.read.format(\"delta\").load(bronze_path)\n",
        "\n",
        "scored_df = (\n",
        "    bronze_df\n",
        "    .withColumn('predicted_vol', predict_vol('log_ret', 'vol_10'))\n",
        ")\n",
        "\n",
        "gold_path = \"data/lakehouse/gold/risk_scores\"\n",
        "scored_df.write.format('delta').mode('overwrite').save(gold_path)\n",
        "print(f\"✅ Risk scores written to Delta table at {gold_path}\")\n"
      ],
      "execution_count": null,
      "outputs": []
    }
  ]
}
